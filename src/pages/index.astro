---
import { getEntry, render } from "astro:content";
import HomepageLayout from "../layouts/HomepageLayout.astro";

const home = await getEntry("pages", "home");
if (!home) throw new Error("Missing src/content/pages/home.md");
const { Content } = await render(home);
---

<HomepageLayout title={home.data.title} description={home.data.description}>
  <main id="content" aria-labelledby="page-title">
    <h1 id="page-title" class="visually-hidden">{home.data.heading}</h1>
    <div class="biography">
      <img
        class="portrait"
        src="/images/homepage-portrait.webp"
        alt="Stippled ink portrait of Lochana Perera smiling"
        width="1121"
        height="1403"
        fetchpriority="high"
      />
      <Content />
    </div>
  </main>
</HomepageLayout>
