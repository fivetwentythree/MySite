---
import { getCollection } from "astro:content";
import { groupWritingsBySource } from "../../lib/group-writings";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/listing.css";

const writings = (await getCollection("writings"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const writingGroups = groupWritingsBySource(writings);
---

<BaseLayout
  title="Recent Writings"
  description="Essays, notes, and field reports."
  currentPath="/writings/"
>
  <div class="page listing-page">
    <header class="listing-header">
      <h1>Recent Writings</h1>
    </header>

    <section class="writing-groups" id="essays" aria-label="Writing list">
      {
        writingGroups.map((group) => (
          <section class="writing-category" aria-labelledby={`source-${group.sourceId}`}>
            <h2 class="writing-category-title" id={`source-${group.sourceId}`}>
              {group.source}
            </h2>
            <div class="writing-list">
              {group.entries.map((entry) => (
                <a class="writing-row" href={`/writings/${entry.id}/`}>
                  <h3>{entry.data.title}</h3>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>
