---
import BaseLayout from "./BaseLayout.astro";
import "../styles/thoughts.css";
import { site } from "../site.config";

const { title, description, date, tags = [] } = Astro.props;

const siteUrl = site.url.replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const publishedTime = date instanceof Date ? date.toISOString() : undefined;
const thoughtSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  headline: title,
  description,
  ...(publishedTime ? { datePublished: publishedTime, dateModified: publishedTime } : {}),
  author: {
    "@type": "Person",
    name: site.fullName,
    url: `${siteUrl}/`
  },
  mainEntityOfPage: canonicalUrl,
  keywords: tags.join(", "),
  inLanguage: "en"
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  currentPath={Astro.url.pathname}
  publishedTime={publishedTime}
  modifiedTime={publishedTime}
  schema={thoughtSchema}
>
  <div class="thought-page">
    <article class="thought-shell">
      <header class="thought-header">
        <p class="thought-kicker">Random Thoughts</p>
        <h1>{title}</h1>
      </header>

      <div class="thought-body">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
