---
import "../styles/base.css";
import { site } from "../site.config";

const {
  title = site.fullName,
  description = site.tagline,
  currentPath = Astro.url.pathname,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  schema
} = Astro.props;

const pageTitle = title === site.fullName ? title : `${title} - ${site.fullName}`;
const siteUrl = site.url.replace(/\/$/, "");
const canonicalUrl = new URL(currentPath || Astro.url.pathname, `${siteUrl}/`).toString();
const absoluteImage = new URL(image || "/social-card.svg", `${siteUrl}/`).toString();
const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: site.fullName,
      description: site.tagline,
      inLanguage: "en"
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: site.fullName,
      url: `${siteUrl}/`,
      sameAs: Object.values(site.social).filter(Boolean),
      knowsAbout: site.keywords
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      about: { "@id": `${siteUrl}/#person` },
      inLanguage: "en"
    }
  ]
};

const structuredData = schema || defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07111f" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.fullName} writings`} href="/rss.xml" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={pageTitle} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        const root = document.documentElement;
        const themeQuery = window.matchMedia("(prefers-color-scheme: dark)");
        let storedTheme;

        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const themeChoice = storedTheme === "dark" || storedTheme === "light" ? storedTheme : null;
        const activeTheme = themeChoice || (themeQuery.matches ? "dark" : "light");

        if (themeChoice) {
          root.dataset.theme = themeChoice;
        }

        root.dataset.activeTheme = activeTheme;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand" href="/" aria-label={`${site.fullName} home`}>
          <span class="brand-name">{site.fullName}</span>
          <span class="brand-kicker">Personal Site</span>
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          {
            site.nav.map((item) => {
              const isCurrent =
                currentPath === item.href ||
                (item.href !== "/" && currentPath.startsWith(item.href));

              return (
                <div class="nav-group">
                  <a
                    class="nav-link"
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                    aria-haspopup={item.children ? "true" : undefined}
                  >
                    {item.label}
                  </a>
                  {item.children && (
                    <div class="nav-children">
                      {item.children.map((child) => (
                        <a class="nav-child" href={child.href}>
                          {child.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              );
            })
          }
        </nav>

        <div class="header-actions">
          <button
            class="theme-toggle"
            type="button"
            role="switch"
            aria-label="Switch to dark theme"
            aria-checked="false"
            data-theme-toggle
          ></button>

          <button
            class="mobile-menu-button"
            type="button"
            aria-label="Open Menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
            data-mobile-menu-button
          >
            <span aria-hidden="true"></span>
          </button>
        </div>
      </header>

      <nav class="mobile-menu-panel" id="mobile-menu" aria-label="Mobile navigation" hidden>
        <div class="mobile-menu-inner">
          {
            site.nav.map((item) => (
              <div class="mobile-menu-group">
                <a class="mobile-menu-link" href={item.href}>
                  <span>{item.label}</span>
                  {item.children && <span class="mobile-menu-arrow" aria-hidden="true"></span>}
                </a>
                {
                  item.children && (
                    <div class="mobile-menu-children" aria-label={`${item.label} links`}>
                      {item.children.map((child) => (
                        <a class="mobile-menu-child" href={child.href}>
                          {child.label}
                        </a>
                      ))}
                    </div>
                  )
                }
              </div>
            ))
          }
        </div>
      </nav>

      <main id="content" class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <span>{site.fullName}</span>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href="/writings/">Writings</a>
            <a href="/thoughts/">Thoughts</a>
            {site.email && <a href={`mailto:${site.email}`}>Contact</a>}
          </nav>
        </div>
      </footer>
    </div>
    <script is:inline>
      const root = document.documentElement;
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const themeStorageKey = "site-theme";
      const themeQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const themeColors = {
        light: "#ffffff",
        dark: "#07111f"
      };

      const menuButton = document.querySelector("[data-mobile-menu-button]");
      const mobileMenu = document.querySelector("#mobile-menu");
      let closeTimer;

      function getStoredTheme() {
        try {
          const storedTheme = window.localStorage.getItem(themeStorageKey);
          return storedTheme === "dark" || storedTheme === "light" ? storedTheme : null;
        } catch {
          return null;
        }
      }

      function storeTheme(theme) {
        try {
          window.localStorage.setItem(themeStorageKey, theme);
        } catch {
          return;
        }
      }

      function resolveTheme(themeChoice = getStoredTheme()) {
        return themeChoice || (themeQuery.matches ? "dark" : "light");
      }

      function updateThemeColor(activeTheme) {
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.setAttribute("content", themeColors[activeTheme]);
        });
      }

      function applyTheme(themeChoice = getStoredTheme()) {
        const activeTheme = resolveTheme(themeChoice);

        if (themeChoice) {
          root.dataset.theme = themeChoice;
        } else {
          delete root.dataset.theme;
        }

        root.dataset.activeTheme = activeTheme;
        updateThemeColor(activeTheme);

        if (!themeToggle) return;

        const isDark = activeTheme === "dark";
        themeToggle.setAttribute("aria-checked", String(isDark));
        themeToggle.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
      }

      themeToggle?.addEventListener("click", () => {
        const nextTheme = resolveTheme() === "dark" ? "light" : "dark";
        storeTheme(nextTheme);
        applyTheme(nextTheme);
      });

      const syncSystemTheme = () => {
        if (!getStoredTheme()) applyTheme(null);
      };

      if (themeQuery.addEventListener) {
        themeQuery.addEventListener("change", syncSystemTheme);
      } else {
        themeQuery.addListener(syncSystemTheme);
      }

      applyTheme();

      function setMobileMenu(open) {
        if (!menuButton || !mobileMenu) return;
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        if (open === isOpen) return;
        window.clearTimeout(closeTimer);

        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute("aria-label", open ? "Close Menu" : "Open Menu");
        document.body.classList.toggle("mobile-menu-open", open);

        if (open) {
          mobileMenu.hidden = false;
          mobileMenu.classList.remove("is-closing");
          requestAnimationFrame(() => mobileMenu.classList.add("is-open"));
          return;
        }

        mobileMenu.classList.remove("is-open");
        mobileMenu.classList.add("is-closing");
        closeTimer = window.setTimeout(() => {
          if (mobileMenu.classList.contains("is-open")) return;
          mobileMenu.hidden = true;
          mobileMenu.classList.remove("is-closing");
        }, 560);
      }

      menuButton?.addEventListener("click", () => {
        setMobileMenu(menuButton.getAttribute("aria-expanded") !== "true");
      });

      mobileMenu?.addEventListener("click", (event) => {
        if (event.target.closest("a")) setMobileMenu(false);
      });

      mobileMenu?.addEventListener("transitionend", (event) => {
        if (event.target !== mobileMenu || mobileMenu.classList.contains("is-open")) return;
        window.clearTimeout(closeTimer);
        mobileMenu.hidden = true;
        mobileMenu.classList.remove("is-closing");
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMobileMenu(false);
      });
    </script>
  </body>
</html>
